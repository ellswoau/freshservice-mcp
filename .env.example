# Copy to .env and fill in. NEVER commit the API key or token.
FRESHSERVICE_DOMAIN=yourcompany
# Optional full base URL override (wins over FRESHSERVICE_DOMAIN).
# FRESHSERVICE_BASE_URL=https://yourcompany.freshservice.com
FRESHSERVICE_API_KEY=
FRESHSERVICE_VERIFY_SSL=true
FRESHSERVICE_TIMEOUT=30
# API key that gates the network MCP endpoints (empty = auth disabled).
# Generate with: openssl rand -hex 32
FRESHSERVICE_MCP_AUTH_TOKEN=
# Optional pointer to a config file written by `config init`.
# FRESHSERVICE_CONFIG_FILE=./freshservice.json

# Optional closure defaults so `resolve_ticket`/`classify_ticket` can fill the
# fields a ticket needs before it will close, without looking up ids first.
# Group/agent accept an id or a name; agent also accepts an email.
# FRESHSERVICE_DEFAULT_GROUP_NAME=Help Desk Team
# FRESHSERVICE_DEFAULT_GROUP_ID=21000395971
# FRESHSERVICE_DEFAULT_AGENT_EMAIL=aellsworth@wellerreman.com
# FRESHSERVICE_DEFAULT_AGENT_ID=21005118452
# FRESHSERVICE_DEFAULT_WORKSPACE_ID=2